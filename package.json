{
  "name": "fb-tg-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Трекер конверсии Facebook Ads → Telegram с REST API и MCP-сервером",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
