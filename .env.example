# Postgres (на Render — «Internal Database URL»)
DATABASE_URL=postgres://user:pass@host:5432/db
# true — если подключаетесь к внешнему адресу Postgres (External URL) с SSL
DATABASE_SSL=false

# Публичный https-адрес сервиса. Telegram принимает вебхуки только по https.
PUBLIC_URL=https://your-service.onrender.com

# Ключ(и) доступа к REST API и MCP, через запятую. Сгенерируйте длинный случайный:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=change-me-to-a-long-random-string

# Вход в веб-панель (/admin). Один пользователь. Пароль — минимум 8 символов.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password

# Необязательно: отдельный домен только для лендингов (рекомендуется), напр. https://promo.example.com
# LANDING_URL=

# Необязательно
PORT=3000
DEFAULT_TZ=Asia/Ho_Chi_Minh
FB_API_VERSION=v23.0
TELEGRAM_SET_WEBHOOK=true

# Токены ботов в env НЕ нужны: бот подключается командой add_bot (REST/MCP).

# Необязательно: домены добавляются в Render автоматически из панели.
# Ключ: Render → Account Settings → API Keys. ID сервиса — в адресе сервиса, вида srv-xxxxxxxx.
# Без этих двух переменных всё работает: панель просто подскажет добавить домен в Render вручную.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# IP для A-записи корневого домена (для Render подставляется 216.24.57.1 сама)
# DNS_A_IP=
